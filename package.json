{
  "name": "connect-4",
  "version": "0.1.1",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.15.1 <12"
  },
  "private": true,
  "scripts": {
    "dev": "next dev -p 4444",
    "build": "next build",
    "mobile:build": "node scripts/mobile-build.mjs",
    "pages:build": "node scripts/github-pages-build.mjs",
    "start": "next start -p 4444",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "release": "release-it",
    "test:e2e:online": "playwright test tests/online-multiplayer.spec.ts --project=chromium-mobile",
    "test:e2e:online:headed": "playwright test tests/online-multiplayer.spec.ts --project=chromium-mobile --headed",
    "test:e2e:mobile": "playwright test tests/mobile-gameplay.spec.ts --project=chromium-mobile",
    "test:e2e:licenses": "playwright test tests/open-source-licenses.spec.ts --project=chromium-mobile",
    "clean": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "android:sync": "pnpm mobile:build && node scripts/capacitor.mjs sync android",
    "android:open": "node scripts/capacitor.mjs open android",
    "android:run": "pnpm android:sync && node scripts/capacitor.mjs run android",
    "android:bundle": "node scripts/android-release.mjs",
    "android:bundle:check": "node scripts/android-release.mjs --unsigned",
    "playstore:capture": "playwright test tests/play-store-captures.spec.ts --project=chromium-mobile",
    "playstore:render": "python scripts/render_play_store_assets.py",
    "notices:check": "node scripts/check-notices.mjs",
    "licenses:generate": "node scripts/generate-open-source-licenses.mjs",
    "licenses:check": "node scripts/check-open-source-licenses.mjs",
    "audit": "pnpm audit --audit-level=moderate",
    "prepublish:check": "pnpm lint && pnpm typecheck && pnpm build && pnpm audit",
    "prepush": "node scripts/pre-push.mjs",
    "postinstall": "node scripts/setup-git-hooks.mjs",
    "cap:telemetry:off": "cap telemetry off",
    "netlify:zip": "node scripts/netlify-source-zip.mjs",
    "licenses:publication-check": "node scripts/check-open-source-licenses.mjs --strict"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "^8.4.2",
    "@hookform/resolvers": "^5.4.0",
    "@types/canvas-confetti": "^1.9.0",
    "autoprefixer": "^10.5.4",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "peerjs": "^1.5.5",
    "pocketbase": "^0.27.0",
    "postcss": "^8.5.23",
    "react": "^19.2.7",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@next/eslint-plugin-next": "16.2.11",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "archiver": "^8.0.0",
    "eslint": "10.8.0",
    "release-it": "^21.0.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
