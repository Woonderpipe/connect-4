NODE_ENV=production
PORT=4444
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Public build configuration. Replace example values before deployment.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SERVERLESS=true
NEXT_PUBLIC_FOOTER_TEXT=Connect 4
# Required only when NEXT_PUBLIC_SERVERLESS=false; it must be a public HTTPS URL.
NEXT_PUBLIC_POCKETBASE_URL=https://api.example.com

# Test transports must remain disabled in public builds.
NEXT_PUBLIC_ONLINE_TEST_MODE=false
ONLINE_TEST_MODE=false

# Optional self-hosted analytics. Enable only after configuring the deployment and privacy policy.
NEXT_PUBLIC_UMAMI_ENABLED=false
# NEXT_PUBLIC_UMAMI_HOST=https://analytics.example.com
# NEXT_PUBLIC_UMAMI_WEB_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_ANDROID_WEBSITE_ID=
# NEXT_PUBLIC_PRIVACY_CONTACT_NAME=
# NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=

# Search-engine ownership verification values. Obtain these from the respective webmaster service.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
