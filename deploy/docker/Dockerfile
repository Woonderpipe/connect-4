# syntax=docker/dockerfile:1

FROM node:24-alpine AS base
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
RUN corepack enable

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_SITE_URL=https://example.com
ARG NEXT_PUBLIC_SERVERLESS=true
ARG NEXT_PUBLIC_FOOTER_TEXT=Connect 4
ARG NEXT_PUBLIC_POCKETBASE_URL=https://api.example.com
ARG NEXT_PUBLIC_ONLINE_TEST_MODE=false
ARG ONLINE_TEST_MODE=false
ARG NEXT_PUBLIC_UMAMI_ENABLED=false
ARG NEXT_PUBLIC_UMAMI_HOST=
ARG NEXT_PUBLIC_UMAMI_WEB_WEBSITE_ID=
ARG NEXT_PUBLIC_UMAMI_ANDROID_WEBSITE_ID=
ARG NEXT_PUBLIC_PRIVACY_CONTACT_NAME=
ARG NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
ARG NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
ARG NEXT_PUBLIC_BING_SITE_VERIFICATION=
ENV NODE_ENV=production \
    NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} \
    NEXT_PUBLIC_SERVERLESS=${NEXT_PUBLIC_SERVERLESS} \
    NEXT_PUBLIC_FOOTER_TEXT=${NEXT_PUBLIC_FOOTER_TEXT} \
    NEXT_PUBLIC_POCKETBASE_URL=${NEXT_PUBLIC_POCKETBASE_URL} \
    NEXT_PUBLIC_ONLINE_TEST_MODE=${NEXT_PUBLIC_ONLINE_TEST_MODE} \
    ONLINE_TEST_MODE=${ONLINE_TEST_MODE} \
    NEXT_PUBLIC_UMAMI_ENABLED=${NEXT_PUBLIC_UMAMI_ENABLED} \
    NEXT_PUBLIC_UMAMI_HOST=${NEXT_PUBLIC_UMAMI_HOST} \
    NEXT_PUBLIC_UMAMI_WEB_WEBSITE_ID=${NEXT_PUBLIC_UMAMI_WEB_WEBSITE_ID} \
    NEXT_PUBLIC_UMAMI_ANDROID_WEBSITE_ID=${NEXT_PUBLIC_UMAMI_ANDROID_WEBSITE_ID} \
    NEXT_PUBLIC_PRIVACY_CONTACT_NAME=${NEXT_PUBLIC_PRIVACY_CONTACT_NAME} \
    NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=${NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL} \
    NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=${NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION} \
    NEXT_PUBLIC_BING_SITE_VERIFICATION=${NEXT_PUBLIC_BING_SITE_VERIFICATION}
RUN pnpm build

FROM node:24-alpine AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=4444 \
    HOSTNAME=0.0.0.0

WORKDIR /app
RUN apk add --no-cache wget \
  && addgroup -S -g 1001 nodejs \
  && adduser -S -u 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 4444

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT}/api/health/ping" || exit 1

CMD ["node", "server.js"]
